# Copy this file to ~/.pi/acontext-sidecar/.env or set ACONTEXT_SIDECAR_HOME.
# Never commit the completed file.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_SDK=openai
LLM_SIMPLE_MODEL=gpt-4.1
BLOCK_EMBEDDING_API_KEY=
BLOCK_EMBEDDING_BASE_URL=https://api.openai.com/v1
BLOCK_EMBEDDING_MODEL=text-embedding-3-small
BLOCK_EMBEDDING_DIM=1536
ROOT_API_BEARER_TOKEN=
# Optional local Phoenix OTLP/gRPC endpoint (host port 14317).
ACONTEXT_OTLP_GRPC_ENDPOINT=http://host.docker.internal:14317
ACONTEXT_OTEL_SAMPLE_RATIO=1.0
# Local-only semantic evaluation. This records complete prompts, messages,
# tool arguments and tool results in Phoenix; do not enable for shared systems.
ACONTEXT_EVALUATION_TRACE_CONTENT=false
ACONTEXT_PHOENIX_PROJECT_NAME=acontext-core
ACONTEXT_API_PHOENIX_PROJECT_NAME=acontext-transport
# Phoenix assigns a distributed trace to the resource of its first span. For
# a noise-free Core evaluation project, disable the API tracer so Core starts
# the trace while Core-to-MQ propagation remains intact.
ACONTEXT_API_OTEL_ENABLED=true
ACONTEXT_API_OTEL_SDK_DISABLED=false
ACONTEXT_OTEL_ATTRIBUTE_COUNT_LIMIT=4096
