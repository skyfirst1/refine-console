# Copy to .env for `npm run web`. Keep credentials on your machine.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
PIPELINE_PROVIDER_ID=deepseek
PIPELINE_MODEL_ID=deepseek-v4-flash
PIPELINE_MAX_TOKENS=8000

# Optional memory service; not required to open the console.
ACONTEXT_API_KEY=
ACONTEXT_BASE_URL=http://127.0.0.1:8029/api/v1
ACONTEXT_SIDECAR_AUTO_START=false
AUTO_DREAM_ENABLED=false
